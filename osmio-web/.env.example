# Copia este archivo a .env y completa los valores:
#   cp .env.example .env
# .env no se versiona (está en .gitignore); no subas credenciales al repositorio.

# --- Supabase ---
# Obligatorias: src/services/supabase/client.ts lanza un error al cargar sin ellas.
# La URL y la anon key están en el panel de Supabase: Project Settings > API.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>

# --- API propia ---
# Opcional. Si no se define, src/services/api/client.ts usa http://localhost:3001/api.
VITE_API_URL=http://localhost:3001/api
